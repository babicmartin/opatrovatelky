{varType App\Model\DTO\MissingRegistry\MissingRegistryRecord|null $newRow}
{varType App\Model\DTO\MissingRegistry\MissingRegistryRecord[] $rows}
{varType App\Model\Utils\Paginator\Paginator $paginator}
{varType App\Model\Enum\MissingRegistry\MissingType[] $types}
{varType array<int, string> $userNames}
{varType array<int, bool> $editableIds}

{define registryRow, App\Model\DTO\MissingRegistry\MissingRegistryRecord $row}
	{if isset($editableIds[$row->id])}
		{include editableRow, $row}
	{else}
		{include readOnlyRow, $row}
	{/if}
{/define}

{define editableRow, App\Model\DTO\MissingRegistry\MissingRegistryRecord $row}
	<div class="row align-items-center">
		<div class="col-xl-11 col-md-12">
			{form "registryForm-$row->id"}
				<div class="row">
					<div class="col-xl-2 col-md-12">
						<div class="mb10">
							<div class="inputLabel">Kto</div>
							{ifset $form['userId']}
								{input userId}
							{else}
								<div class="form-control-plaintext">{$userNames[$row->userId] ?? '---'}</div>
							{/ifset}
						</div>
					</div>
					<div class="col-xl-2 col-md-12">
						<div class="mb10">
							<div style="font-weight:bold; font-size:16px;">Od</div>
							{input dateFrom}
						</div>
					</div>
					<div class="col-xl-2 col-md-12">
						<div class="mb10">
							<div style="font-weight:bold; font-size:16px;">Do</div>
							{input dateTo}
						</div>
					</div>
					<div class="col-xl-3 col-md-12">
						<div class="mb10 mt-3 row">
							{foreach $types as $type}
								{var $typeField = $type->field()}
								{* the last, longest label keeps the rest of the row *}
								<div n:class="$iterator->last ? 'col-8' : 'col-4'">{input $typeField} {$type->label()}</div>
							{/foreach}
						</div>
					</div>
					<div class="col-xl-3 col-md-12">
						<div class="mb10">
							<div style="font-weight:bold; font-size:16px;">Poznámka</div>
							{input notice}
						</div>
					</div>
				</div>
				{input save}
			{/form}
		</div>
		<div class="col-xl-1 col-md-12">
			{form "deleteRegistryForm-$row->id"}{input delete}{/form}
		</div>
	</div>
{/define}

{define readOnlyRow, App\Model\DTO\MissingRegistry\MissingRegistryRecord $row}
	<div class="row align-items-center missing-registry-readonly">
		<div class="col-xl-11 col-md-12">
			<div class="row">
				<div class="col-xl-2 col-md-12">
					<div class="mb10">
						<div class="inputLabel">Kto</div>
						<div class="form-control-plaintext">{$userNames[$row->userId] ?? '---'}</div>
					</div>
				</div>
				<div class="col-xl-2 col-md-12">
					<div class="mb10">
						<div style="font-weight:bold; font-size:16px;">Od</div>
						<div class="form-control-plaintext">{$row->dateFrom?->format('d.m.Y')}</div>
					</div>
				</div>
				<div class="col-xl-2 col-md-12">
					<div class="mb10">
						<div style="font-weight:bold; font-size:16px;">Do</div>
						<div class="form-control-plaintext">{$row->dateTo?->format('d.m.Y')}</div>
					</div>
				</div>
				<div class="col-xl-3 col-md-12">
					<div class="mb10 mt-3">
						<span n:foreach="$row->types as $type" class="badge me-1" n:attr="style: 'background-color:' . $type->color()">{$type->label()}</span>
					</div>
				</div>
				<div class="col-xl-3 col-md-12">
					<div class="mb10">
						<div style="font-weight:bold; font-size:16px;">Poznámka</div>
						<div class="form-control-plaintext">{$row->notice|breakLines}</div>
					</div>
				</div>
			</div>
		</div>
	</div>
{/define}

<div class="space20"></div>
{form createMissingRegistryForm}
	{input create}
{/form}

<div class="space20"></div>
{if $newRow !== null}
	<div class="divone">
		<div class="divone-header">
			<h3 class="divone-title">Nový záznam</h3>
		</div>
		<div>
			{include registryRow, $newRow}
		</div>
	</div>
{/if}

<div class="space20"></div>
<div class="divone">
	<div class="divone-header">
		<h3 class="divone-title">Evidencia</h3>
	</div>
	<div>
		{foreach $rows as $row}
			{include registryRow, $row}
		{/foreach}
	</div>
</div>

<div class="space20"></div>
{include '../../../../templates/components/paginator.latte', paginator: $paginator}
