# Hodnoty pre automatické testy (APP_ENV=test). Súbor je v Gite: žiadne skutočné heslá.
# V testovacom prostredí sa config/.env nenačíta. Odlišné hodnoty pre vlastný stroj
# (napríklad iný port databázy) patria do config/.env.test.local, ktorý Git ignoruje.
TEST_DATABASE_DSN="mysql:host=127.0.0.1;port=3307;dbname=opatrovatelky_nette_test"
TEST_DATABASE_USER=root
TEST_DATABASE_PASSWORD=
MEDIA_COOKIE_SECRET=test0media0cookie0secret
