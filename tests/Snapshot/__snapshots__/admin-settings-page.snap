<!DOCTYPE html>
<html lang="sk" dir="ltr">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=0">
	<meta content="4MS - administrácia" name="description">

	<title>4MS - administrácia</title>

	<link rel="icon" href="/assets/images/brand/favicon.ico" type="image/x-icon">
	<link id="style" href="/assets/plugins/bootstrap/css/bootstrap.min.css" rel="stylesheet">
	<link href="/assets/css/main.css?***" rel="stylesheet">
	<link href="/assets/css/custom.css?***" rel="stylesheet">
	<link href="/assets/css/pdf.css?***" rel="stylesheet">

	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@shoelace-style/shoelace@2.0.0/dist/themes/light.css">
	<script type="module" src="https://cdn.jsdelivr.net/npm/@shoelace-style/shoelace@2.0.0/dist/shoelace.js"></script>

	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" integrity="sha512-Evv84Mr4kqVGRNSgIGL/F/aIDqQb7xQ2vcrdIwxfjThSH8CSR7PBEakCr51Ck+w+/U6swU2Im1vVX0SVk9ABhg==" crossorigin="anonymous" referrerpolicy="no-referrer">
	<script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.2.1/js/all.min.js" integrity="sha512-rpLlll167T5LJHwp0waJCh3ZRf7pO6IT1+LZOhAyP6phAirwchClbTZV3iqL3BMrVxIYRbzGTpli4rfxsCK6Vw==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>

	<link rel="stylesheet" href="https://code.jquery.com/ui/1.13.2/themes/base/jquery-ui.css">
	<script src="https://code.jquery.com/jquery-3.6.0.js"></script>
	<script src="https://code.jquery.com/ui/1.13.2/jquery-ui.js"></script>
	<script>
		$(function() {
			$(".datepicker").datepicker({
				changeMonth: true,
				changeYear: true,
				dateFormat: "dd.mm.yy"
			});
		});
	</script>

</head>

<body>
	<div class="container-fluid topmenu" style="max-width:1500px;">
		<div class="row">
			<div class="col-xl-3 col-md-1 col-sm-2 col-3">
				<a class="logo-horizontal" href="/">
					<img src="/img/logo.png" class="header-brand-img desktop-lgo d-none d-xl-block" alt="4MS">
					<img src="/img/logo-small.png" class="d-xl-none" alt="4MS">
				</a>
			</div>
<div class="col-xl-7 d-none d-xl-block">
	<input type="text" class="form-control search" data-id="1" data-search-url="/settings?do=search-search" data-type-param="search-type" data-term-param="search-term" placeholder="Opatrovateľky" autocomplete="off">
	<input type="text" class="form-control search" data-id="2" data-search-url="/settings?do=search-search" data-type-param="search-type" data-term-param="search-term" placeholder="Rodiny" autocomplete="off">
	<input type="text" class="form-control search" data-id="5" data-search-url="/settings?do=search-search" data-type-param="search-type" data-term-param="search-term" placeholder="Kont.osoba" autocomplete="off">
	<input type="text" class="form-control search" data-id="3" data-search-url="/settings?do=search-search" data-type-param="search-type" data-term-param="search-term" placeholder="Partneri" autocomplete="off">
	<input type="text" class="form-control search" data-id="4" data-search-url="/settings?do=search-search" data-type-param="search-type" data-term-param="search-term" placeholder="Agentúry" autocomplete="off">
</div>
<div class="col-6 col-md-10 col-sm-8 d-xl-none">
	<button type="button" class="msearch-trigger" data-msearch-open aria-label="Vyhľadávanie">
		<i class="fas fa-magnifying-glass"></i>
		<span>Hľadať…</span>
	</button>

	<div id="mobileSearch" class="msearch" role="dialog" aria-modal="true" aria-label="Vyhľadávanie" hidden
		data-search-url="/settings?do=search-searchMobile"
		data-type-param="search-type"
		data-term-param="search-term">
		<div class="msearch-head">
			<div class="msearch-bar">
				<button type="button" class="msearch-back" data-msearch-close aria-label="Zavrieť"><i class="fas fa-arrow-left"></i></button>
				<div class="msearch-field">
					<input type="search" class="msearch-input" placeholder="Meno, priezvisko, číslo klienta…" autocomplete="off" autocorrect="off" autocapitalize="off" spellcheck="false" enterkeyhint="search">
					<span class="msearch-spinner" aria-hidden="true"></span>
					<button type="button" class="msearch-clear" aria-label="Vymazať" hidden><i class="fas fa-xmark"></i></button>
				</div>
			</div>
			<div class="msearch-chips" role="tablist">
				<button type="button" class="msearch-chip active" data-type="">Všetko</button>
				<button type="button" class="msearch-chip" data-type="1">Opatrovateľky <span class="msearch-count"></span></button>
				<button type="button" class="msearch-chip" data-type="2">Rodiny <span class="msearch-count"></span></button>
				<button type="button" class="msearch-chip" data-type="5">Kont. osoby <span class="msearch-count"></span></button>
				<button type="button" class="msearch-chip" data-type="3">Partneri <span class="msearch-count"></span></button>
				<button type="button" class="msearch-chip" data-type="4">Agentúry <span class="msearch-count"></span></button>
			</div>
		</div>
		<div class="msearch-body">
			<div class="msearch-results"></div>
			<p class="msearch-hint">Zadajte aspoň 3 znaky.</p>
		</div>
	</div>
</div>
			<div class="col-xl-2 col-md-1 offset-md-0 col-sm-2 offset-sm-0 col-3">
				<div class="logout fright">
					<form action="/logout/" method="post" id="frm-logoutForm">
						<button name="send" value="Odhlásiť sa" type="submit" aria-label="Odhlásiť sa" style="background:transparent; border:0; padding:0; cursor:pointer;">
							<span class="d-none d-xl-inline">Odhlásiť sa</span>
							<i class="fas fa-power-off d-xl-none" style="font-size:35px; color:#8A2062; padding-top:8px;"></i>
						</button>
					<input type="hidden" name="_token_" value="***"><input type="hidden" name="_do" value="logoutForm-submit"></form>
				</div>
				<div class="fright d-none d-xl-block">
<a href="/user-management/update" class="">
	<img src="/img/users/empty.jpg" alt="Profil" class="rounded-circle avatar" style="max-width:50px; max-height:50px;">
</a>
				</div>
			</div>
		</div>
	</div>

	<div class="fullnavbar">
		<div class="container-fluid" style="max-width:1500px;">
			<nav class="navbar navbar-expand-lg navbar-light mainMenu">
				<div class="container-fluid">
					<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
						<span class="navbar-toggler-icon"></span> <span class="navbar-toggler-label">MENU</span>
					</button>
					<div class="collapse navbar-collapse" id="navbarNav">
<ul class="navbar-nav" style="margin-right: 0px;">
	<li class="nav-item">
		<a class="nav-link" style="color:#C0C4DD" href="/">
			<svg xmlns="http://www.w3.org/2000/svg" class="side-menu__icon" style="fill: #ccd4e0 !important;" width="24" height="24" viewBox="0 0 24 24">
				<path d="M3 13h1v7c0 1.103.897 2 2 2h12c1.103 0 2-.897 2-2v-7h1a1 1 0 0 0 .707-1.707l-9-9a.999.999 0 0 0-1.414 0l-9 9A1 1 0 0 0 3 13zm7 7v-5h4v5h-4zm2-15.586 6 6V15l.001 5H16v-5c0-1.103-.897-2-2-2h-4c-1.103 0-2 .897-2 2v5H6v-9.586l6-6z"></path>
			</svg>
			<span>Firma 4MS</span>
		</a>
	</li>

</ul>
					</div>
				</div>
			</nav>
		</div>
	</div>

	<div class="container-fluid" style="max-width:1500px;">
